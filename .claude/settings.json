{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npx prisma migrate *)",
      "Bash(pnpm prisma migrate *)",
      "Edit(prisma/**)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(docs/arch/**)",
      "Edit(docs/**)"
    ],
    "allow": [
      "Bash(pnpm test *)",
      "Bash(pnpm run *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}